---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
const posts = [{ href: '/articles/filters-vs-ducts', t: 'למה שטיפת פילטרים לא מנקה את התעלות', d: 'מה הפילטר עוצר, מה עובר אותו, ומתי כדאי לנקות את התעלות עצמן.' }];
---
<Base title="מאמרים" description="מאמרים על ניקוי ותחזוקה של מערכות מיזוג ותעלות אוויר.">
  <PageHead title="מאמרים" />
  <section class="section"><div class="wrap"><ul class="posts">{posts.map((p) => <li><a href={p.href}><h2>{p.t}</h2><p>{p.d}</p></a></li>)}</ul></div></section>
</Base>
<style>
  .posts { list-style: none; padding: 0; margin: 0; border-top: 2px solid var(--navy); }
  .posts a { display: grid; gap: .4rem; padding-block: 1.4rem; border-bottom: 1px solid var(--line); text-decoration: none; }
  .posts h2 { font-size: var(--step-2); } .posts p { color: var(--muted); } .posts a:hover h2 { color: var(--blue); }
</style>
