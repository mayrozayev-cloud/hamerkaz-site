---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import QuoteWizard from '../components/QuoteWizard.astro';
import { equipment, guarantees, business } from '../data/site';
---
<Base title="אודות" description="המרכז למיזוג וחיטוי: ניקוי וחיטוי של מערכות מיזוג ותעלות אוויר, בשיטת עבודה מסודרת ועם תיעוד מלא.">
  <PageHead title="אודות המרכז" lede="אנחנו מתמחים בדבר אחד: ניקוי של מערכות מיזוג מבפנים, כולל התעלות שמאחורי התריס." />
  <section class="section"><div class="wrap two">
    <div class="stack">
      <h2>איך אנחנו עובדים</h2>
      <p>אנחנו מגיעים עם ציוד שנכנס לתוך התעלה: מברשות ייעודיות, מערכת שאיבה של 3,600W וסינון HEPA. כל עבודה מתועדת לפני ואחרי, כדי שתראו בדיוק מה נוקה.</p>
      <p>אנחנו עובדים {business.areaSummary}, בבתים פרטיים, בדירות, במשרדים ובמוסדות.</p>
    </div>
    <div class="stack">
      <h2>ההתחייבות שלנו</h2>
      <ul class="g">{guarantees.map((g) => <li><b>{g.title}</b><span>{g.note}</span></li>)}</ul>
    </div>
  </div></section>
  <section class="section on-duct"><div class="wrap stack"><h2>הציוד</h2>
    <dl class="eq">{equipment.map((e) => <div><dt>{e.k} · {e.t}</dt><dd>{e.d}</dd></div>)}</dl>
  </div></section>
  <QuoteWizard showFaq={false} />
</Base>
<style>
  .two { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-l); } @media (max-width: 820px) { .two { grid-template-columns: 1fr; } }
  .g { list-style: none; padding: 0; margin: 0; border-top: 2px solid var(--navy); }
  .g li { display: flex; justify-content: space-between; gap: 1rem; padding-block: .9rem; border-bottom: 1px solid var(--line); flex-wrap: wrap; }
  .g b { font-family: var(--display); font-weight: 800; color: var(--navy); } .g span { color: var(--muted); }
  .eq { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--space-m); margin: 0; }
  .eq dt { font-family: var(--display); font-weight: 900; color: #fff; font-size: 1.15rem; margin-bottom: .4rem; } .eq dd { margin: 0; color: var(--on-duct-muted); }
  @media (max-width: 820px) { .eq { grid-template-columns: 1fr 1fr; } } @media (max-width: 480px) { .eq { grid-template-columns: 1fr; } }
</style>
