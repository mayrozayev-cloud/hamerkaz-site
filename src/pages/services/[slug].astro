---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import QuoteWizard from '../../components/QuoteWizard.astro';
import { services, journey, waLink } from '../../data/site';
export function getStaticPaths() { return services.map((s) => ({ params: { slug: s.slug }, props: { s } })); }
const { s } = Astro.props;
const others = services.filter((o) => o.slug !== s.slug);
---
<Base title={s.title} description={`${s.title}: ${s.short} ${s.intro.slice(0, 110)}`}>
  <section class="svc-hero">
    <div class="wrap sh">
      <div class="stack">
        <nav aria-label="פירורי לחם" class="crumbs"><a href="/">דף הבית</a> / <span>{s.title}</span></nav>
        <h1>{s.title}</h1>
        <p class="lede">{s.intro}</p>
        <div class="row"><a class="btn btn-primary" href="#quote">קבלת הצעת מחיר</a><a class="btn btn-line" href={waLink(`שלום, אשמח לפרטים על ${s.title}`)}><Icon name="whatsapp" />וואטסאפ</a></div>
      </div>
      <figure class="sh-ph"><img src="/img/grille-open.webp" alt="תריס יניקה פתוח בתקרה, עם התעלה מאחוריו" width="900" height="1120" /></figure>
    </div>
  </section>
  <div class="louvers" aria-hidden="true"></div>
  <section class="section">
    <div class="wrap two">
      <div class="stack"><h2>מה כולל השירות</h2>
        <ul class="ticks">{s.includes.map((x) => <li><Icon name="check" />{x}</li>)}</ul>
      </div>
      <div class="stack"><h2>סימנים שהגיע הזמן</h2>
        <ul class="ticks warn">{s.signs.map((x) => <li><Icon name="wind" />{x}</li>)}</ul>
        <p class="muted"><b>מתאים ל:</b> {s.forWho}</p>
      </div>
    </div>
  </section>
  <section class="section on-duct">
    <div class="wrap stack">
      <h2>איך זה עובד</h2>
      <ol class="flow">{journey.map((j, i) => <li><span class="n">{i + 1}</span><h3>{j.t}</h3><p>{j.d}</p></li>)}</ol>
    </div>
  </section>
  <QuoteWizard />
  <section class="section">
    <div class="wrap stack"><h2>שירותים נוספים</h2>
      <ul class="more">{others.map((o) => <li><a href={`/services/${o.slug}`}>{o.title}</a></li>)}</ul>
    </div>
  </section>
</Base>
<style>
  .svc-hero { padding-block: var(--space-l); }
  .sh { display: grid; grid-template-columns: 1.3fr .7fr; gap: var(--space-l); align-items: center; }
  .sh h1 { font-size: var(--step-4); letter-spacing: -0.025em; }
  .crumbs { font-size: .9rem; color: var(--muted); }
  .row { display: flex; gap: .7rem; flex-wrap: wrap; }
  .sh-ph { margin: 0; }
  .sh-ph img { width: 100%; aspect-ratio: 4/5; object-fit: cover; border: 12px solid var(--paper); border-radius: 4px; box-shadow: 0 0 0 1px var(--line), 0 24px 44px -28px rgb(10 42 98 / .5); }
  @media (max-width: 820px) { .sh { grid-template-columns: 1fr; } .sh-ph { max-width: 360px; } }
  .two { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-l); }
  @media (max-width: 820px) { .two { grid-template-columns: 1fr; } }
  .ticks { list-style: none; padding: 0; margin: 0; display: grid; gap: .7rem; }
  .ticks li { display: flex; gap: .6rem; align-items: start; }
  .ticks :global(.icon) { width: 1.3rem; height: 1.3rem; color: var(--turq); flex: none; margin-top: .25rem; stroke-width: 2.4; }
  .ticks.warn :global(.icon) { color: var(--blue); stroke-width: 1.8; }
  .flow { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: var(--space-m); counter-reset: s; }
  .flow li { display: grid; gap: .5rem; align-content: start; border-top: 2px solid rgb(255 255 255 / .2); padding-top: 1rem; }
  .flow .n { font-family: var(--display); font-weight: 900; font-size: var(--step-2); color: var(--turq); line-height: 1; font-variant-numeric: tabular-nums; }
  .flow p { color: var(--on-duct-muted); font-size: .98rem; }
  @media (max-width: 900px) { .flow { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 520px) { .flow { grid-template-columns: 1fr; } }
  .more { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: .6rem; }
  .more a { display: inline-block; padding: .6rem 1.1rem; border: 1.5px solid var(--navy); border-radius: 999px; text-decoration: none; font-weight: 700; color: var(--navy); }
  .more a:hover { background: var(--navy); color: #fff; }
</style>
