---
// One authored icon set: 24px grid, 1.8 stroke, round caps.
interface Props { name: 'whatsapp' | 'phone' | 'check' | 'arrow' | 'play' | 'plus' | 'shield' | 'camera' | 'broom' | 'wind'; class?: string }
const { name, class: cls } = Astro.props;
---
<svg class:list={["icon", cls]} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {name === 'whatsapp' && <><path d="M4 20l1.2-3.6A8 8 0 1 1 8 19.1z" /><path d="M9 9.2c.2 1.9 1.9 4 4 4.8l1.1-1.1 1.9.8c-.2 1-1.1 1.8-2.2 1.7C10.6 15 8.2 12.4 8 9.6c0-1 .7-1.9 1.7-2.1l.9 1.8z" /></>}
  {name === 'phone' && <path d="M5 4h3l1.6 4-2 1.3a10.5 10.5 0 0 0 7.1 7.1l1.3-2 4 1.6v3a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2z" />}
  {name === 'check' && <path d="M5 12.5l4.2 4.2L19 7" />}
  {name === 'arrow' && <path d="M19 12H5m6-6l-6 6 6 6" />}
  {name === 'play' && <path d="M8 5.5v13l10.5-6.5z" />}
  {name === 'plus' && <path d="M12 5v14M5 12h14" />}
  {name === 'shield' && <><path d="M12 3l7 3v5.5c0 4.4-3 8.2-7 9.5-4-1.3-7-5.1-7-9.5V6z" /><path d="M9 12l2.2 2.2L15.5 10" /></>}
  {name === 'camera' && <><path d="M4 8h3l1.6-2.5h6.8L17 8h3v11H4z" /><circle cx="12" cy="13.2" r="3.4" /></>}
  {name === 'broom' && <><path d="M14 4l-3.5 7" /><path d="M7.5 11h6l2.5 9H5z" /><path d="M9 15l-.6 5M12 15v5M14.6 15l.9 5" /></>}
  {name === 'wind' && <><path d="M3 9h11a3 3 0 1 0-3-3" /><path d="M3 14h15a3 3 0 1 1-3 3" /></>}
</svg>
