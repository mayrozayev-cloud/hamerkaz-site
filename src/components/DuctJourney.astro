---
import { journey } from '../data/site';
// Deterministic dust: blobs along the lower and upper duct walls.
let seed = 7;
const rnd = () => ((seed = (seed * 16807) % 2147483647) / 2147483647);
const dust = Array.from({ length: 150 }, (_, i) => {
  const lower = i % 3 !== 0;
  const x = 60 + rnd() * 860;
  const y = lower ? 258 + rnd() * 20 : 82 + rnd() * 12;
  return { x: +x.toFixed(1), y: +y.toFixed(1), rx: +(3 + rnd() * 9).toFixed(1), ry: +(1.6 + rnd() * 4).toFixed(1), o: +(0.55 + rnd() * 0.45).toFixed(2), c: rnd() > 0.5 ? '#8c8172' : '#6f675d' };
});
const bristles = Array.from({ length: 44 }, (_, i) => (i / 44) * Math.PI * 2);
const joints = [190, 340, 490, 640, 790];
---
<section class="journey on-duct" id="inside" aria-labelledby="journey-title">
  <div class="wrap intro">
    <h2 id="journey-title">מה קורה בתוך התעלה</h2>
    <p class="lede">החלק שלא רואים מהתריס. כך נראה ניקוי תעלה, שלב אחרי שלב.</p>
  </div>
  <div class="pin" data-journey>
    <div class="wrap stage">
      <svg class="duct" viewBox="0 30 1000 300" role="img" aria-labelledby="duct-desc">
        <desc id="duct-desc">איור של חתך תעלת מיזוג: אבק על הדפנות, מברשת ומערכת שאיבה שמנקות אותה, ותעלה נקייה בסוף.</desc>
        <defs>
          <linearGradient id="steel" x1="0" x2="0" y1="0" y2="1"><stop offset="0" stop-color="#8aa0b8" /><stop offset="1" stop-color="#4f6680" /></linearGradient>
          <linearGradient id="inside" x1="0" x2="0" y1="0" y2="1"><stop offset="0" stop-color="#13294a" /><stop offset="1" stop-color="#0b1b33" /></linearGradient>
          <clipPath id="ductclip"><rect x="20" y="-200" width="960" height="560" /></clipPath>
          <linearGradient id="clean" x1="0" x2="0" y1="0" y2="1"><stop offset="0" stop-color="#1d4f7e" /><stop offset="1" stop-color="#123a63" /></linearGradient>
        </defs>
        <rect x="40" y="80" width="920" height="200" fill="url(#inside)" />
        <rect class="clean-fill" x="40" y="80" width="920" height="200" fill="url(#clean)" opacity="0" />
        <g class="air">
          {[130, 170, 210, 245].map((y, i) => <path d={`M960 ${y} C 760 ${y - 18}, 620 ${y + 18}, 420 ${y} S 120 ${y - 12}, 40 ${y}`} fill="none" stroke="#a7d8f0" stroke-width={i % 2 ? 2 : 3} stroke-linecap="round" stroke-dasharray="26 22" />)}
        </g>
        <g class="dust">{dust.map((d) => <ellipse cx={d.x} cy={d.y} rx={d.rx} ry={d.ry} fill={d.c} opacity={d.o} />)}</g>
        <rect x="20" y="60" width="960" height="22" fill="url(#steel)" />
        <rect x="20" y="278" width="960" height="22" fill="url(#steel)" />
        {joints.map((x) => <><rect x={x} y="56" width="8" height="30" fill="#9fb3c8" /><rect x={x} y="274" width="8" height="30" fill="#9fb3c8" /></>)}
        <g class="hatch"><rect x="820" y="56" width="110" height="26" fill="#f3f6f8" /><path d="M828 63h94M828 69h94M828 75h94" stroke="#c3ced8" stroke-width="2" /></g>
        <g class="hose">
          <path d="M880 -40 C 880 20, 880 60, 875 120" fill="none" stroke="#1b1f24" stroke-width="30" stroke-linecap="round" />
          <path d="M880 -40 C 880 20, 880 60, 875 120" fill="none" stroke="#3a414a" stroke-width="30" stroke-dasharray="3 7" />
          <rect x="852" y="112" width="46" height="34" rx="6" fill="#111418" />
        </g>
        <g class="brush" clip-path="url(#ductclip)">
          <g class="rod"><line x1="0" y1="180" x2="1300" y2="180" stroke="#c9d3dc" stroke-width="8" /></g>
          <g class="head">{bristles.map((a) => <line x1="0" y1="0" x2={(Math.cos(a) * 92).toFixed(1)} y2={(Math.sin(a) * 92).toFixed(1)} stroke="#e2c98f" stroke-width="3" stroke-linecap="round" />)}<circle r="14" fill="#9aa7b4" /></g>
        </g>
      </svg>
      <ol class="steps">
        {journey.map((s, i) => <li data-step={i} class={i === 0 ? 'on' : ''}><span class="n">{i + 1}</span><div><h3>{s.t}</h3><p>{s.d}</p></div></li>)}
      </ol>
    </div>
  </div>
  <div class="wrap outro"><p class="muted note">האיור ממחיש את התהליך ואינו בקנה מידה. הצילומים האמיתיים מהעבודות נמצאים למטה.</p></div>
</section>

<style>
  .journey { padding-block: var(--space-l) var(--space-m); }
  .pin { min-height: calc(100vh - 72px); display: grid; align-items: center; }
  .intro { display: grid; gap: .6rem; margin-bottom: var(--space-m); }
  .stage { display: grid; grid-template-columns: minmax(0, 1.7fr) minmax(0, 1fr); gap: var(--space-m); align-items: center; min-height: min(78vh, 640px); }
  .duct { width: 100%; height: auto; overflow: visible; }
  .brush, .hose { visibility: hidden; }
  .steps { list-style: none; margin: 0; padding: 0; display: grid; gap: .4rem; }
  .steps li { display: grid; grid-template-columns: 2.2rem 1fr; gap: .8rem; padding: .7rem .9rem; border-radius: 8px; opacity: .45; transition: opacity .35s var(--ease-out), background-color .35s; }
  .steps li.on { opacity: 1; background: rgb(255 255 255 / .06); }
  .steps .n { width: 2.2rem; height: 2.2rem; border-radius: 50%; display: grid; place-items: center; border: 1.5px solid var(--on-duct-muted); font-family: var(--display); font-weight: 800; font-variant-numeric: tabular-nums; }
  .steps li.on .n { background: var(--turq); border-color: var(--turq); color: var(--turq-ink); }
  .steps h3 { font-size: 1.1rem; }
  .steps p { color: var(--on-duct-muted); font-size: .98rem; line-height: 1.5; }
  .note { font-size: .88rem; margin-top: var(--space-s); }
  @media (max-width: 900px) {
    .stage { grid-template-columns: 1fr; min-height: auto; align-content: center; gap: 1.2rem; }
    .steps li { opacity: .35; padding: .45rem .6rem; }
    .steps li:not(.on) p { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .dust { opacity: 0; } .brush, .hose { display: none; } .clean-fill { opacity: 1; } .steps li { opacity: 1; } .steps li:not(.on) p { display: block; }
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);
  const root = document.querySelector<HTMLElement>('[data-journey]');
  const mm = gsap.matchMedia();
  if (root) mm.add('(prefers-reduced-motion: no-preference)', () => {
    const steps = root.querySelectorAll<HTMLElement>('.steps li');
    const dust = gsap.utils.toArray<SVGEllipseElement>('.dust ellipse', root);
    const setStep = (p: number) => { const i = Math.min(4, Math.floor(p * 5)); steps.forEach((s, k) => s.classList.toggle('on', k === i)); };
    gsap.set('.air', { opacity: 0.12 });
    gsap.set('.hose', { y: -170, visibility: 'visible' });
    gsap.set(['.head', '.rod'], { x: 1120 });
    gsap.set('.head', { y: 180, transformOrigin: '50% 50%' });
    gsap.set('.brush', { visibility: 'visible' });
    const tl = gsap.timeline({ defaults: { ease: 'power2.inOut' }, scrollTrigger: {
      trigger: root, start: 'top 72px', end: '+=360%', pin: true, scrub: 0.7, onUpdate: (st) => setStep(st.progress),
    } });
    // 1. dust builds up
    tl.from(dust, { scale: 0, transformOrigin: 'center', stagger: { each: 0.004, from: 'random' }, duration: 1 }, 0)
    // 2. hatch opens, hose drops in, brush arrives at the duct mouth
      .to('.hatch', { y: -40, opacity: 0, duration: 0.6 }, 1)
      .to('.hose', { y: 0, duration: 0.8 }, 1.1)
      .to(['.head', '.rod'], { x: 900, duration: 0.8 }, 1.1)
    // 3. brush travels the duct and loosens the layer
      .to('.head', { x: 130, rotation: -1440, duration: 1.4, ease: 'none' }, 2)
      .to('.rod', { x: 130, duration: 1.4, ease: 'none' }, 2)
      .to(dust, { y: () => gsap.utils.random(-26, 26), x: () => gsap.utils.random(-12, 12), duration: 1.2, stagger: { each: 0.004, from: 'end' } }, 2.1)
    // 4. extraction pulls everything to the nozzle
      .to(dust, { attr: { cx: 875, cy: 128 }, x: 0, y: 0, opacity: 0, duration: 1, ease: 'power3.in', stagger: { each: 0.004, from: 'end' } }, 3.1)
      .to('.head', { x: 1120, rotation: -2880, duration: 0.9 }, 3.4)
      .to('.rod', { x: 1120, duration: 0.9 }, 3.4)
    // 5. clean duct, air moves freely
      .to('.hose', { y: -170, duration: 0.6 }, 4.1)
      .to('.hatch', { y: 0, opacity: 1, duration: 0.4 }, 4.3)
      .to('.clean-fill', { opacity: 1, duration: 0.6 }, 4.1)
      .to('.air', { opacity: 1, duration: 0.6 }, 4.2)
      .to('.air path', { strokeDashoffset: -480, duration: 1, ease: 'none' }, 4.2);
    return () => tl.scrollTrigger?.kill();
  });
</script>
