---
import Icon from './Icon.astro';
import { business, waLink, telLink } from '../data/site';
---
<section class="final" id="quote" aria-labelledby="final-title">
  <div class="wrap inner">
    <div class="stack" style="gap:.8rem">
      <h2 id="final-title">אוויר נקי מתחיל בשיחה אחת.</h2>
      <p class="lede">כתבו לנו מה יש לכם בבית או במשרד, ונחזור עם הצעה ומועד. {business.areaSummary}.</p>
    </div>
    <div class="acts">
      <a class="btn btn-primary big" href={waLink()} data-track="Contact"><Icon name="whatsapp" />כתבו לנו בוואטסאפ</a>
      <a class="btn btn-ghost big" href={telLink()} data-track="Contact"><Icon name="phone" />{business.phone ?? 'חיוג'}</a>
      <a class="calc-link" href="#price">או מלאו פרטים בדקה</a>
    </div>
  </div>
</section>
<style>
  .final { background: radial-gradient(90% 120% at 80% 0%, #164a7c 0%, var(--navy) 45%, var(--duct) 100%); color: #fff; padding-block: var(--space-xl); }
  .inner { display: grid; grid-template-columns: 1.2fr .8fr; gap: var(--space-l); align-items: center; }
  h2 { color: #fff; font-size: var(--step-4); letter-spacing: -.03em; }
  .lede { color: #c7d9e8; }
  .acts { display: grid; gap: .8rem; }
  .big { min-height: 64px; font-size: 1.15rem; }
  .btn-ghost { background: rgb(255 255 255 / .08); color: #fff; border-color: rgb(255 255 255 / .5); }
  .btn-ghost:hover { background: #fff; color: var(--navy); }
  .calc-link { color: var(--tchelet); font-weight: 700; justify-self: center; }
  @media (max-width: 820px) { .inner { grid-template-columns: 1fr; } }
</style>
