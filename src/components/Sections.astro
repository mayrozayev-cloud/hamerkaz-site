---
// Home-page body sections between the duct journey and the quote area.
import Icon from './Icon.astro';
import { equipment, services } from '../data/site';
const reels = [
  { src: '/video/reel1.mp4', poster: '/video/reel1.jpg', t: 'פתיחת תריס ושאיבת התעלה' },
  { src: '/video/reel2.mp4', poster: '/video/reel2.jpg', t: 'שאיבה של 3,600W לתוך התעלה' },
  { src: '/video/reel3.mp4', poster: '/video/reel3.jpg', t: 'מה שיוצא מהתעלות' },
];
---
<section class="section gear" aria-labelledby="gear-title">
  <div class="wrap gear-grid">
    <figure class="gear-ph"><img src="/img/crew-hose.webp" alt="טכנאי מחזיק את צינור השאיבה של 3,600W בתוך פתח תעלה" width="900" height="917" loading="lazy" /></figure>
    <div class="stack">
      <h2 id="gear-title">הציוד שנכנס לתעלה</h2>
      <p class="lede">כדי לנקות תעלה צריך להגיע לתוכה. זה הציוד שאיתו אנחנו מגיעים לכל עבודה.</p>
      <dl class="spec">
        {equipment.map((e) => <div><dt><span class="k">{e.k}</span> {e.t}</dt><dd>{e.d}</dd></div>)}
      </dl>
    </div>
  </div>
</section>

<section class="section services on-duct" aria-labelledby="svc-title">
  <div class="wrap stack">
    <h2 id="svc-title">מה אנחנו מנקים</h2>
    <ul class="svc">
      {services.map((s) => <li><a href={`/services/${s.slug}`}><span class="st">{s.title}</span><span class="sd">{s.short}</span><Icon name="arrow" class="go" /></a></li>)}
    </ul>
  </div>
</section>

<section class="section work on-duct" id="work" aria-labelledby="work-title">
  <div class="wrap stack">
    <h2 id="work-title">מהשטח</h2>
    <p class="lede">סרטונים מעבודות אמיתיות, בלי עריכה של התוצאה.</p>
    <div class="reels">
      {reels.map((r) => <figure><video controls playsinline preload="none" poster={r.poster} width="720" height="1280"><source src={r.src} type="video/mp4" /></video><figcaption>{r.t}</figcaption></figure>)}
    </div>
  </div>
</section>

<style>
  .fv { display: grid; grid-template-columns: 1.1fr .8fr .8fr; gap: var(--space-m); align-items: end; }
  .ph { margin: 0; display: grid; gap: .5rem; }
  .ph img { width: 100%; aspect-ratio: 4/5; object-fit: cover; border-radius: 4px; box-shadow: 0 24px 40px -28px rgb(10 42 98 / .5); }
  .ph-b { transform: translateY(var(--space-m)); }
  .ph figcaption { font-family: var(--display); font-weight: 800; color: var(--navy); }
  @media (max-width: 900px) { .fv { grid-template-columns: 1fr 1fr; } .fv-copy { grid-column: 1 / -1; } .ph-b { transform: none; } }

  .gear-grid { display: grid; grid-template-columns: .8fr 1.2fr; gap: var(--space-l); align-items: center; }
  .gear-ph { margin: 0; }
  .gear-ph img { width: 100%; aspect-ratio: 4/5; object-fit: cover; border-radius: 4px; border: 12px solid var(--paper); box-shadow: 0 0 0 1px var(--line), 0 24px 44px -28px rgb(10 42 98 / .5); }
  .spec { margin: var(--space-s) 0 0; display: grid; border-top: 2px solid var(--navy); }
  .spec > div { display: grid; grid-template-columns: minmax(9rem, .7fr) 1.3fr; gap: 1rem; padding-block: 1rem; border-bottom: 1px solid var(--line); }
  .spec dt { font-family: var(--display); font-weight: 800; color: var(--navy); }
  .spec .k { display: block; font-size: var(--step-2); line-height: 1; color: var(--blue); font-variant-numeric: tabular-nums; }
  .spec dd { margin: 0; color: var(--muted); }
  @media (max-width: 820px) { .gear-grid { grid-template-columns: 1fr; } .gear-ph { max-width: 420px; } .spec > div { grid-template-columns: 1fr; gap: .3rem; } }

  .svc { list-style: none; padding: 0; margin: 0; border-top: 1px solid rgb(255 255 255 / .16); }
  .svc a { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr) auto; gap: 1rem; align-items: center; padding-block: 1.3rem; border-bottom: 1px solid rgb(255 255 255 / .16); text-decoration: none; color: var(--on-duct); transition: padding .3s var(--ease-out), color .2s; }
  .svc .st { font-family: var(--display); font-weight: 900; font-size: var(--step-2); line-height: 1.1; color: #fff; }
  .svc .sd { color: var(--on-duct-muted); }
  .svc :global(.go) { width: 1.6rem; height: 1.6rem; color: var(--turq); transition: transform .3s var(--ease-out); }
  .svc a:hover { padding-inline-start: .6rem; }
  .svc a:hover :global(.go) { transform: translateX(-6px); }
  @media (max-width: 700px) { .svc a { grid-template-columns: 1fr auto; } .svc .sd { grid-column: 1; } .svc :global(.go) { grid-row: 1 / span 2; grid-column: 2; } }

  .prob-table { display: grid; border-top: 2px solid var(--navy); }
  .pr { display: grid; grid-template-columns: 1fr 1.2fr 1.2fr; gap: 1.2rem; padding-block: 1.05rem; border-bottom: 1px solid var(--line); }
  .pr.head { font-size: .85rem; color: var(--muted); font-weight: 700; letter-spacing: .02em; padding-block: .6rem; }
  .pr b { font-family: var(--display); font-weight: 800; color: var(--navy); font-size: 1.1rem; }
  .pr span { color: var(--muted); }
  @media (max-width: 760px) { .pr { grid-template-columns: 1fr; gap: .25rem; } .pr.head { display: none; } .pr span:last-child { color: var(--ink); } .pr span:last-child::before { content: "הפתרון: "; font-weight: 700; color: var(--blue); } }

  .reels { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-m); }
  .reels figure { margin: 0; display: grid; gap: .6rem; }
  .reels video { width: 100%; aspect-ratio: 9/16; object-fit: cover; border-radius: 6px; background: #000; }
  .reels figcaption { font-family: var(--display); font-weight: 800; color: #fff; }
  @media (max-width: 760px) { .reels { grid-template-columns: repeat(3, 72%); overflow-x: auto; scroll-snap-type: x mandatory; padding-bottom: .5rem; } .reels figure { scroll-snap-align: start; } }
</style>
