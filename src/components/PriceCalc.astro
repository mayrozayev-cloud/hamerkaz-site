---
import Icon from './Icon.astro';

import { business } from '../data/site';
---
<section class="section calc" id="price" aria-labelledby="calc-title">
  <div class="wrap grid">
    <div class="intro stack">
      <h2 id="calc-title">הצעה מותאמת בדקה</h2>
      <p class="lede">ספרו לנו מה יש לכם, ונחזור עם הצעה מסודרת ומועד. בלי התחייבות.</p>
      <ul class="why">
        <li><b>סוג המערכת ומספר היחידות</b><span>מיני מרכזי, עיליים או VRF</span></li>
        <li><b>מספר התעלות ופתחי היציאה</b><span>ואורך התעלות</span></li>
        <li><b>הגישה לתעלות</b><span>פתח שירות קיים או צורך בפתיחה</span></li>
        <li><b>מצב המערכת</b><span>ריח, אבק או כתמים שתיארתם</span></li>
      </ul>
      <p class="muted small">אלה הדברים שקובעים את ההצעה. ככל שתפרטו יותר, ההצעה שתקבלו תהיה מדויקת יותר.</p>
    </div>

    <form class="box" data-calc data-wa={business.whatsapp ?? ''} novalidate>
      <fieldset>
        <legend>איזו מערכת יש לכם?</legend>
        <div class="seg" role="radiogroup">
          {[['mini', 'מיני מרכזי'], ['wall', 'מזגנים עיליים'], ['vrf', 'VRF / משרד'], ['ducts', 'תעלות בלבד']].map(([v, t], i) => (
            <label><input type="radio" name="sys" value={v} checked={i === 0} /><span>{t}</span></label>
          ))}
        </div>
      </fieldset>
      <div class="steppers">
        <div class="st" data-row="units">
          <span class="lbl" id="l-units">יחידות פנימיות</span>
          <div class="ctl"><button type="button" data-dec="units" aria-label="פחות יחידות">−</button><output data-out="units" aria-labelledby="l-units">1</output><button type="button" data-inc="units" aria-label="עוד יחידה">+</button></div>
        </div>
        <div class="st" data-row="ducts">
          <span class="lbl" id="l-ducts">תעלות / פתחי יציאה</span>
          <div class="ctl"><button type="button" data-dec="ducts" aria-label="פחות תעלות">−</button><output data-out="ducts" aria-labelledby="l-ducts">4</output><button type="button" data-inc="ducts" aria-label="עוד תעלה">+</button></div>
        </div>
        <div class="st" data-row="walls" hidden>
          <span class="lbl" id="l-walls">מזגנים עיליים</span>
          <div class="ctl"><button type="button" data-dec="walls" aria-label="פחות מזגנים">−</button><output data-out="walls" aria-labelledby="l-walls">2</output><button type="button" data-inc="walls" aria-label="עוד מזגן">+</button></div>
        </div>
      </div>
      <div class="row2">
        <label class="f"><span>סוג נכס</span>
          <select name="prop"><option>דירה</option><option>בית פרטי</option><option>משרד</option><option>עסק</option><option>מוסד</option></select>
        </label>
        <label class="f"><span>עיר</span><input name="city" type="text" autocomplete="address-level2" placeholder="למשל: רחובות" /></label>
      </div>
      <fieldset>
        <legend class="sm">מה מפריע לכם? (לא חובה)</legend>
        <div class="chips">{['ריח מהמזגן', 'אבק שחוזר', 'כתמים שחורים', 'טפטוף', 'אין פתח שירות'].map((o) => <label><input type="checkbox" name="issue" value={o} /><span>{o}</span></label>)}</div>
      </fieldset>

      <div class="total" aria-live="polite"><div><small>הסיכום שיישלח אלינו</small><p class="sum" data-sum></p></div></div>
      <div class="send">
        <button type="submit" class="btn btn-primary"><Icon name="whatsapp" />שלחו וקבלו הצעה</button>
        <a class="btn btn-line" href={`tel:${business.phone?.replace(/\D/g, '') ?? ''}`} data-track="Contact"><Icon name="phone" />או התקשרו</a>
      </div>
    </form>
  </div>
</section>

<style>
  .calc { background: linear-gradient(180deg, var(--ceiling) 0%, #e4ecf1 100%); }
  .grid { display: grid; grid-template-columns: minmax(0, .9fr) minmax(0, 1.1fr); gap: var(--space-l); align-items: start; }
  .intro { position: sticky; top: 100px; }
  .flag { display: inline-flex; gap: .5rem; align-items: center; }
  .flag span { background: var(--navy); color: #fff; font-family: var(--display); font-weight: 800; padding: .25rem .8rem; border-radius: 999px; font-size: .9rem; }
  .flag em { font-style: normal; color: var(--blue); font-weight: 700; }
  .tags { display: grid; grid-template-columns: 1fr 1fr; gap: .8rem; }
  .tag { background: var(--paper); border: 1px solid var(--line); border-radius: 12px; padding: 1rem 1.1rem; display: grid; gap: .2rem; }
  .tag small { color: var(--muted); font-weight: 600; }
  .tag b { font-family: var(--display); font-weight: 900; font-size: clamp(2rem, 1.5rem + 2vw, 3rem); line-height: 1; color: var(--navy); font-variant-numeric: tabular-nums; }
  .tag b span { font-size: .9rem; font-weight: 800; color: var(--blue); margin-inline-end: .2rem; }
  .tag.gift { grid-column: 1 / -1; background: var(--navy); border-color: var(--navy); }
  .tag.gift small { color: var(--tchelet); }
  .tag .g { font-size: var(--step-1); color: #fff; line-height: 1.25; }
  .small { font-size: .88rem; line-height: 1.55; }

  .box { background: var(--paper); border-radius: 16px; padding: clamp(1.2rem, 1rem + 1.6vw, 2.2rem); display: grid; gap: 1.3rem; box-shadow: 0 1px 0 var(--line), 0 40px 80px -50px rgb(10 42 98 / .55); }
  fieldset { border: 0; margin: 0; padding: 0; min-width: 0; }
  legend { font-family: var(--display); font-weight: 900; color: var(--navy); font-size: var(--step-1); margin-bottom: .7rem; padding: 0; }
  legend.sm { font-size: 1rem; font-weight: 800; }
  .seg { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: .4rem; background: var(--ceiling); padding: .35rem; border-radius: 12px; }
  .seg label, .chips label { position: relative; }
  .seg input, .chips input { position: absolute; inset: 0; opacity: 0; cursor: pointer; }
  .seg span { display: grid; place-items: center; text-align: center; min-height: 48px; padding: .3rem; border-radius: 9px; font-weight: 700; font-size: .95rem; line-height: 1.2; color: var(--ink); transition: background-color .2s, color .2s; }
  .seg input:checked + span { background: var(--navy); color: #fff; box-shadow: 0 6px 14px -8px rgb(10 42 98 / .8); }
  .seg input:focus-visible + span, .chips input:focus-visible + span { outline: 3px solid var(--turq); outline-offset: 2px; }
  .steppers { display: grid; gap: .6rem; }
  .st { display: flex; justify-content: space-between; align-items: center; gap: 1rem; padding: .5rem 0; border-bottom: 1px solid var(--line); }
  .lbl { font-weight: 700; }
  .ctl { display: flex; align-items: center; gap: .3rem; }
  .ctl button { width: 44px; height: 44px; border-radius: 50%; border: 1.5px solid var(--line); background: var(--ceiling); font-size: 1.3rem; font-weight: 700; color: var(--navy); cursor: pointer; }
  .ctl button:hover { border-color: var(--blue); }
  .ctl output { min-width: 2.4rem; text-align: center; font-family: var(--display); font-weight: 900; font-size: 1.4rem; font-variant-numeric: tabular-nums; color: var(--navy); }
  .row2 { display: grid; grid-template-columns: 1fr 1fr; gap: .8rem; }
  .f { display: grid; gap: .3rem; font-weight: 700; font-size: .95rem; color: var(--navy); }
  .f input, .f select { min-height: 48px; border: 1.5px solid var(--line); border-radius: 10px; padding: .5rem .8rem; font: inherit; font-weight: 400; color: var(--ink); background: var(--paper); }
  .f input::placeholder { color: #6b7d8c; }
  .chips { display: flex; flex-wrap: wrap; gap: .45rem; }
  .chips span { display: inline-flex; min-height: 42px; align-items: center; padding: .35rem .9rem; border-radius: 999px; border: 1.5px solid var(--line); font-weight: 600; font-size: .93rem; }
  .chips input:checked + span { background: var(--tchelet); border-color: var(--blue); color: var(--navy); }
  .total { display: flex; justify-content: space-between; align-items: end; gap: 1rem; flex-wrap: wrap; background: var(--duct); color: #fff; border-radius: 12px; padding: 1rem 1.2rem; }
  .total > div { display: grid; }
  .total small { color: var(--on-duct-muted); font-weight: 600; }
  .total strong { font-family: var(--display); font-weight: 900; font-size: clamp(2.2rem, 1.6rem + 2vw, 3.2rem); line-height: 1.05; font-variant-numeric: tabular-nums; }
  .gift-line { display: flex; gap: .4rem; align-items: center; color: #9ff0e6; font-weight: 700; font-size: .95rem; }
  .gift-line :global(.icon) { color: var(--turq); stroke-width: 2.6; }
  .send { display: flex; gap: .7rem; flex-wrap: wrap; }
  .send .btn-primary { flex: 1 1 260px; }
  @media (max-width: 900px) { .grid { grid-template-columns: 1fr; } .intro { position: static; } }
  @media (max-width: 560px) { .seg { grid-template-columns: 1fr 1fr; } .row2 { grid-template-columns: 1fr; } }
</style>

<script>
  import { track } from '../scripts/track';
  const f = document.querySelector<HTMLFormElement>('[data-calc]');
  if (f) {
    const v: Record<string, number> = { units: 1, ducts: 4, walls: 2 };
    const max: Record<string, number> = { units: 6, ducts: 30, walls: 12 };
    const out = (k: string) => f.querySelector<HTMLOutputElement>(`[data-out="${k}"]`)!;
    const row = (k: string) => f.querySelector<HTMLElement>(`[data-row="${k}"]`)!;
    const sumEl = f.querySelector<HTMLElement>('[data-sum]')!;
    const sys = () => (f.querySelector<HTMLInputElement>('input[name=sys]:checked')?.value ?? 'mini');
    const calc = () => {
      const s = sys();
      row('units').hidden = !(s === 'mini'); row('ducts').hidden = !(s === 'mini' || s === 'ducts'); row('walls').hidden = s !== 'wall';
      Object.keys(v).forEach((k) => (out(k).textContent = String(v[k])));
      const names: Record<string, string> = { mini: 'מיני מרכזי', wall: 'מזגנים עיליים', vrf: 'VRF / משרד', ducts: 'תעלות בלבד' };
      const parts = [names[s]];
      if (s === 'mini') parts.push(`${v.units} יחידות פנימיות`);
      if (s === 'mini' || s === 'ducts') parts.push(`${v.ducts} תעלות`);
      if (s === 'wall') parts.push(`${v.walls} מזגנים`);
      sumEl.textContent = parts.join(' · ');
    };
    f.addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest<HTMLButtonElement>('button[data-inc],button[data-dec]'); if (!b) return;
      const k = b.dataset.inc ?? b.dataset.dec!; v[k] = Math.max(k === 'units' ? 1 : 0, Math.min(max[k], v[k] + (b.dataset.inc ? 1 : -1))); calc();
    });
    f.addEventListener('change', calc);
    f.addEventListener('submit', (e) => {
      e.preventDefault();
      const d = new FormData(f); const s = sys();
      const names: Record<string, string> = { mini: 'מיני מרכזי', wall: 'מזגנים עיליים', vrf: 'VRF / משרד', ducts: 'תעלות בלבד' };
      const lines = ['שלום, אשמח להצעה לניקוי מערכת המיזוג:', `מערכת: ${names[s]}`];
      if (s === 'mini') lines.push(`יחידות פנימיות: ${v.units}`);
      if (s === 'mini' || s === 'ducts') lines.push(`תעלות: ${v.ducts}`);
      if (s === 'wall') lines.push(`מזגנים: ${v.walls}`);
      lines.push(`נכס: ${d.get('prop')}`, `עיר: ${d.get('city') || '-'}`);
      const issues = d.getAll('issue'); if (issues.length) lines.push(`מה מפריע: ${issues.join(', ')}`);
      const params = new URLSearchParams(location.search); const src = params.get('utm_campaign') || params.get('utm_source'); if (src) lines.push(`(מקור: ${src})`);
      track('Lead', { content_name: 'quote-builder' });
      const wa = f.dataset.wa; if (wa) location.href = `https://wa.me/${wa}?text=${encodeURIComponent(lines.join('\n'))}`;
    });
    calc();
  }
</script>

<style>
  .why { list-style: none; margin: 0; padding: 0; display: grid; border-top: 2px solid var(--navy); }
  .why li { display: grid; gap: .1rem; padding-block: .8rem; border-bottom: 1px solid var(--line); }
  .why b { font-family: var(--display); font-weight: 800; color: var(--navy); }
  .why span { color: var(--muted); font-size: .95rem; }
  .sum { font-family: var(--display); font-weight: 800; font-size: var(--step-1); color: #fff; margin-top: .2rem; }
</style>
