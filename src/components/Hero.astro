---
import Icon from './Icon.astro';
import { guarantees, waLink } from '../data/site';
---
<section class="hero" aria-labelledby="hero-title">
  <video class="bg" autoplay muted loop playsinline preload="metadata" poster="/video/hero-wide-poster.jpg" aria-hidden="true" tabindex="-1">
    <source src="/video/hero-loop.webm" type="video/webm" media="(max-width: 760px)" />
    <source src="/video/hero-loop.mp4" type="video/mp4" media="(max-width: 760px)" />
    <source src="/video/hero-wide.webm" type="video/webm" />
    <source src="/video/hero-wide.mp4" type="video/mp4" />
  </video>
  <div class="shade" aria-hidden="true"></div>

  <div class="wrap content">
    <div class="copy">
      <h1 id="hero-title">האוויר שאתם נושמים מתחיל בתוך המזגן שלכם.</h1>
      <p class="sub">ניקוי וחיטוי מקצועי של מערכות מיזוג ותעלות אוויר, בטכנולוגיה מתקדמת ובשיטת ניקוי אמריקאית.</p>
      <div class="ctas">
        <a class="btn btn-primary" href="#quote">קבלת הצעת מחיר</a>
        <a class="btn btn-ghost" href="#quote" data-open-wizard>התאמת הצעה אישית</a>
        <a class="btn btn-ghost" href="#work"><Icon name="play" />צפו בתוצאות</a>
      </div>
    </div>
    <ul class="promises">
      {guarantees.map((g) => <li><Icon name="check" /><span><b>{g.title}</b><small>{g.note}</small></span></li>)}
    </ul>
  </div>
  <p class="credit">צילום אמיתי מעבודה שלנו</p>
  <a class="wa-float" href={waLink()} aria-label="כתבו לנו בוואטסאפ"><Icon name="whatsapp" /></a>
</section>

<style>
  .hero {
    position: relative; isolation: isolate; overflow: clip; color: #fff;
    min-height: min(calc(100svh - 72px), 860px);
    display: grid; align-items: end;
    background: var(--duct);
  }
  .bg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: -2; }
  .shade {
    position: absolute; inset: 0; z-index: -1;
    background:
      linear-gradient(to left, rgb(6 18 38 / .78) 0%, rgb(6 18 38 / .45) 45%, rgb(6 18 38 / .1) 75%),
      linear-gradient(to top, rgb(6 18 38 / .92) 0%, rgb(6 18 38 / .35) 45%, rgb(6 18 38 / 0) 70%);
  }
  .content { display: grid; gap: var(--space-l); padding-block: var(--space-l) var(--space-m); }
  .copy { display: grid; gap: var(--space-s); max-width: 40rem; }
  h1 { color: #fff; font-size: clamp(2.4rem, 1.5rem + 3.6vw, 4.8rem); letter-spacing: -0.03em; line-height: 1.02; text-shadow: 0 2px 30px rgb(0 0 0 / .25); }
  .sub { font-size: var(--step-1); line-height: 1.5; color: #dbe8f3; max-width: 34ch; }
  .ctas { display: flex; flex-wrap: wrap; gap: .7rem; margin-top: .6rem; }
  .btn-ghost { background: rgb(255 255 255 / .1); color: #fff; border-color: rgb(255 255 255 / .55); backdrop-filter: blur(6px); }
  .btn-ghost:hover { background: #fff; color: var(--navy); }

  .promises { list-style: none; margin: 0; padding: var(--space-s) 0 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1rem; border-top: 1px solid rgb(255 255 255 / .22); }
  .promises li { display: flex; gap: .55rem; align-items: start; line-height: 1.3; }
  .promises :global(.icon) { color: var(--turq); stroke-width: 2.6; margin-top: .15rem; }
  .promises span { display: grid; }
  .promises b { font-family: var(--display); font-weight: 800; }
  .promises small { color: #b9cde0; font-size: .86rem; }

  .credit { position: absolute; top: 1rem; inset-inline-end: max(16px, env(safe-area-inset-right, 0px)); font-size: .8rem; color: rgb(255 255 255 / .75); background: rgb(6 18 38 / .4); padding: .2rem .6rem; border-radius: 999px; }
  .wa-float { position: absolute; inset-inline-end: max(16px, env(safe-area-inset-right, 0px)); bottom: var(--space-m); width: 58px; height: 58px; border-radius: 50%; display: grid; place-items: center; background: var(--turq); color: var(--turq-ink); box-shadow: 0 10px 28px -8px rgb(0 0 0 / .5); }
  .wa-float :global(.icon) { width: 28px; height: 28px; }

  @media (max-width: 980px) { .promises { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 760px) {
    .hero { min-height: calc(100svh - 72px - 72px); }
    .shade { background: linear-gradient(to top, rgb(6 18 38 / .95) 0%, rgb(6 18 38 / .6) 45%, rgb(6 18 38 / .15) 80%); }
    .ctas .btn { flex: 1 1 100%; }
    .ctas .btn-ghost { flex: 1 1 0; min-width: 0; font-size: .92rem; padding-inline: .6em; white-space: nowrap; }
    .promises { display: none; }
    .wa-float { display: none; }
  }

  @media (prefers-reduced-motion: no-preference) {
    .copy > * { animation: rise .9s var(--ease-out) both; }
    .copy > :nth-child(2) { animation-delay: .08s; }
    .copy > :nth-child(3) { animation-delay: .16s; }
    .bg { animation: settle 2.4s var(--ease-out) both; }
  }
  @keyframes rise { from { opacity: 0; transform: translateY(18px); } }
  @keyframes settle { from { transform: scale(1.08); } }
</style>

<script>
  if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
    document.querySelectorAll<HTMLVideoElement>('.hero video').forEach((v) => { v.pause(); v.removeAttribute('autoplay'); });
  }
</script>
