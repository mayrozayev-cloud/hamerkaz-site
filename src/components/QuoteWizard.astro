---
import Icon from './Icon.astro';
import { business, faq } from '../data/site';
interface Props { showFaq?: boolean }
const { showFaq = true } = Astro.props;
const wa = business.whatsapp ?? '';
---
{showFaq && (
<section class="section faq" aria-labelledby="faq-title">
  <div class="wrap faq-grid">
    <div class="stack"><h2 id="faq-title">שאלות שחוזרות אלינו</h2><p class="lede">לא מצאתם תשובה? כתבו לנו, ונענה.</p></div>
    <div class="qa">{faq.map((f) => <details><summary>{f.q}<Icon name="plus" /></summary><p>{f.a}</p></details>)}</div>
  </div>
</section>
)}

<section class="section quote" id="quote" aria-labelledby="quote-title">
  <div class="wrap q-grid">
    <div class="stack q-intro">
      <h2 id="quote-title">ספרו לנו על המערכת, ונחזור עם הצעה.</h2>
      <p class="lede">ארבע שאלות קצרות. הפרטים נשלחים אלינו בוואטסאפ, או שנחזור אליכם בטלפון.</p>
    </div>
    <form class="wizard" data-wizard data-wa={wa} novalidate>
      <fieldset data-q="0">
        <legend>איזו מערכת יש לכם?</legend>
        <div class="opts">
          {['מיני מרכזי', 'מזגנים עיליים', 'מערכת VRF', 'תעלות בלבד', 'לא בטוח'].map((o, i) => <label><input type="radio" name="system" value={o} /><span>{o}</span></label>)}
        </div>
      </fieldset>
      <fieldset data-q="1">
        <legend>כמה פתחי יציאה או תעלות, בערך?</legend>
        <div class="opts">{['1–3', '4–6', '7–10', 'יותר מ-10', 'לא יודע'].map((o) => <label><input type="radio" name="ducts" value={o} /><span>{o}</span></label>)}</div>
      </fieldset>
      <fieldset data-q="2">
        <legend>איזה נכס?</legend>
        <div class="opts">{['דירה', 'בית פרטי', 'משרד', 'עסק או חנות', 'מוסד'].map((o) => <label><input type="radio" name="property" value={o} /><span>{o}</span></label>)}</div>
      </fieldset>
      <fieldset data-q="3">
        <legend>עוד משהו שנכון לגביכם?</legend>
        <div class="opts">{['ריח מהמזגן', 'אבק שחוזר', 'כתמים שחורים בפתחים', 'טפטוף', 'אין פתח שירות בתקרה'].map((o) => <label><input type="checkbox" name="extras" value={o} /><span>{o}</span></label>)}</div>
        <div class="fields">
          <label class="f"><span>עיר</span><input name="city" type="text" autocomplete="address-level2" placeholder="למשל: אשדוד" /></label>
          <label class="f"><span>שם</span><input name="name" type="text" autocomplete="name" /></label>
          <label class="f"><span>טלפון לחזרה</span><input name="phone" type="tel" inputmode="tel" autocomplete="tel" dir="ltr" /></label>
        </div>
      </fieldset>
      <p class="err" role="alert" hidden></p>
      <div class="nav-row">
        <button type="button" class="btn btn-line" data-back hidden>חזרה</button>
        <span class="prog" aria-live="polite"><span data-pos>1</span> מתוך 4</span>
        <button type="button" class="btn btn-navy" data-next>המשך</button>
        <button type="submit" class="btn btn-primary" data-send hidden><Icon name="whatsapp" />שליחה בוואטסאפ</button>
      </div>
      <div class="done" hidden>
        <h3>הפרטים מוכנים.</h3>
        <p data-done-msg></p>
        <pre data-summary></pre>
      </div>
    </form>
  </div>
</section>

<style>
  .faq-grid { display: grid; grid-template-columns: .8fr 1.2fr; gap: var(--space-l); }
  .qa { border-top: 2px solid var(--navy); }
  .qa details { border-bottom: 1px solid var(--line); }
  .qa summary { list-style: none; display: flex; justify-content: space-between; gap: 1rem; align-items: center; padding-block: 1.1rem; cursor: pointer; font-family: var(--display); font-weight: 800; font-size: 1.12rem; color: var(--navy); }
  .qa summary::-webkit-details-marker { display: none; }
  .qa summary :global(.icon) { width: 1.3rem; height: 1.3rem; flex: none; transition: transform .3s var(--ease-out); color: var(--blue); }
  .qa details[open] summary :global(.icon) { transform: rotate(45deg); }
  .qa p { padding-bottom: 1.1rem; color: var(--muted); }
  @media (max-width: 820px) { .faq-grid { grid-template-columns: 1fr; gap: var(--space-m); } }

  .quote { background: linear-gradient(180deg, var(--ceiling-2), var(--ceiling)); }
  .q-grid { display: grid; grid-template-columns: .8fr 1.2fr; gap: var(--space-l); align-items: start; }
  .wizard { background: var(--paper); border: 1px solid var(--line); border-radius: 12px; padding: clamp(1.2rem, 1rem + 1.5vw, 2.2rem); box-shadow: 0 30px 60px -40px rgb(10 42 98 / .45); display: grid; gap: 1.2rem; }
  fieldset { border: 0; padding: 0; margin: 0; display: grid; gap: 1rem; min-width: 0; }
  legend { font-family: var(--display); font-weight: 900; font-size: var(--step-1); color: var(--navy); margin-bottom: .9rem; padding: 0; }
  .opts { display: flex; flex-wrap: wrap; gap: .55rem; }
  .opts label { position: relative; }
  .opts input { position: absolute; opacity: 0; inset: 0; cursor: pointer; }
  .opts span { display: inline-flex; align-items: center; min-height: 48px; padding: .5rem 1.05rem; border: 1.5px solid var(--line); border-radius: 999px; font-weight: 700; color: var(--ink); background: var(--ceiling); transition: background-color .2s, border-color .2s, color .2s; }
  .opts label:hover span { border-color: var(--blue); }
  .opts input:checked + span { background: var(--navy); border-color: var(--navy); color: #fff; }
  .opts input:focus-visible + span { outline: 3px solid var(--turq); outline-offset: 2px; }
  .fields { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: .8rem; margin-top: .4rem; }
  .f { display: grid; gap: .3rem; font-weight: 700; font-size: .95rem; color: var(--navy); }
  .f input { min-height: 48px; border: 1.5px solid var(--line); border-radius: 8px; padding: .5rem .8rem; font: inherit; font-weight: 400; color: var(--ink); background: var(--paper); }
  .f input::placeholder { color: #6b7d8c; }
  .f input:focus { border-color: var(--blue); outline: none; box-shadow: 0 0 0 3px rgb(26 78 142 / .2); }
  .nav-row { display: flex; align-items: center; gap: .8rem; flex-wrap: wrap; }
  .prog { margin-inline-end: auto; color: var(--muted); font-variant-numeric: tabular-nums; font-size: .95rem; }
  .err { color: #a8261c; font-weight: 700; }
  .done { display: grid; gap: .6rem; }
  .done pre { white-space: pre-wrap; font-family: var(--body); background: var(--ceiling); border-radius: 8px; padding: 1rem; margin: 0; }
  @media (max-width: 900px) { .q-grid { grid-template-columns: 1fr; gap: var(--space-m); } .fields { grid-template-columns: 1fr; } }
</style>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-wizard]');
  if (form) {
    const qs = [...form.querySelectorAll<HTMLFieldSetElement>('fieldset')];
    const back = form.querySelector<HTMLButtonElement>('[data-back]')!;
    const next = form.querySelector<HTMLButtonElement>('[data-next]')!;
    const send = form.querySelector<HTMLButtonElement>('[data-send]')!;
    const err = form.querySelector<HTMLElement>('.err')!;
    const pos = form.querySelector<HTMLElement>('[data-pos]')!;
    let i = 0;
    const show = () => {
      qs.forEach((q, k) => (q.hidden = k !== i));
      back.hidden = i === 0; next.hidden = i === qs.length - 1; send.hidden = i !== qs.length - 1;
      pos.textContent = String(i + 1); err.hidden = true;
    };
    const answered = () => i > 2 || !!form.querySelector(`fieldset[data-q="${i}"] input:checked`);
    next.addEventListener('click', () => {
      if (!answered()) { err.textContent = 'בחרו אחת מהאפשרויות כדי להמשיך.'; err.hidden = false; return; }
      i++; show(); qs[i].querySelector<HTMLInputElement>('input')?.focus();
    });
    back.addEventListener('click', () => { i--; show(); });
    document.querySelectorAll('[data-open-wizard]').forEach((a) => a.addEventListener('click', () => setTimeout(() => qs[0].querySelector('input')?.focus(), 400)));
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const d = new FormData(form);
      const phone = String(d.get('phone') || '').trim();
      if (phone && !/^[0-9+\-\s]{9,15}$/.test(phone)) { err.textContent = 'מספר הטלפון לא נראה תקין. בדקו שוב או השאירו ריק.'; err.hidden = false; return; }
      const lines = [
        'שלום, אשמח להצעה לניקוי מערכת מיזוג.',
        `מערכת: ${d.get('system') ?? '-'}`, `פתחים/תעלות: ${d.get('ducts') ?? '-'}`, `נכס: ${d.get('property') ?? '-'}`,
        `עיר: ${d.get('city') || '-'}`, `הערות: ${d.getAll('extras').join(', ') || '-'}`,
        `שם: ${d.get('name') || '-'}`, `טלפון: ${phone || '-'}`,
      ];
      const text = lines.join('\n');
      const wa = form.dataset.wa;
      const done = form.querySelector<HTMLElement>('.done')!;
      form.querySelector<HTMLElement>('[data-summary]')!.textContent = text;
      if (wa) {
        window.location.href = `https://wa.me/${wa}?text=${encodeURIComponent(text)}`;
        form.querySelector<HTMLElement>('[data-done-msg]')!.textContent = 'פתחנו לכם את וואטסאפ עם הפרטים. נשאר רק ללחוץ "שליחה".';
      } else {
        form.querySelector<HTMLElement>('[data-done-msg]')!.textContent = 'מספר הוואטסאפ של העסק עוד לא הוגדר באתר. אלה הפרטים שנשלח:';
      }
      qs.forEach((q) => (q.hidden = true)); form.querySelector<HTMLElement>('.nav-row')!.hidden = true; done.hidden = false;
    });
    show();
  }
</script>
